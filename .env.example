# ============================================================================
# NEVUS AI — Environment Variables (Local, AI Studio & Vercel Production)
# Never commit actual secret values. Set these in Vercel > Project > Settings > Environment Variables.
# ============================================================================

# --- Primary AI Providers (Server-side only) ---
# Required for Gemini AI, Google Search Grounding, Speech TTS/STT, and Master Intelligence
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional multi-model gateway providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Application & Session Security ---
# Production deployment URL (e.g. https://nevus-ai.vercel.app) used for Google OAuth callbacks
APP_URL="http://localhost:3000"

# REQUIRED in Vercel production: 32+ char random hex string for signing session cookies & encrypting OAuth tokens
# Generate with: openssl rand -hex 32
NEXUS_SESSION_SECRET=""

# Optional secret to protect Vercel Cron endpoint (/api/cron/automation)
CRON_SECRET=""

# --- Production Cloud Database (Recommended on Vercel) ---
# Option A: Supabase (PostgREST HTTPS — run supabase/schema.sql in Supabase SQL Editor)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Option B: Firebase Admin Service Account JSON (stringified JSON for server-side Firestore on Vercel)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- Google Ecosystem OAuth 2.0 & APIs ---
# Create Web Application OAuth credentials in Google Cloud Console
# Add Authorized Redirect URI: https://<your-vercel-domain>/api/google/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""

# Optional Google Ecosystem API Keys (Server-side proxy)
GOOGLE_MAPS_API_KEY=""
GOOGLE_TRANSLATE_API_KEY=""
YOUTUBE_API_KEY=""

# Optional GitHub Personal Access Token for AI Development Lab
GITHUB_TOKEN=""
